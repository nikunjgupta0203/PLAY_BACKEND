{
  "name": "pl4y-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/app.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "dev:all": "tsx watch --env-file-if-exists=.env src/all.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/app.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "start:all": "node --env-file-if-exists=.env dist/all.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run guard && npm run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "seed:dev": "tsx --env-file-if-exists=.env scripts/seed-dev-data.ts",
    "schema:generate": "tsx --env-file-if-exists=.env scripts/write-schema.ts",
    "guard": "tsx scripts/guard.ts",
    "keys:dev": "tsx scripts/gen-keys.ts",
    "admin:grant": "tsx --env-file-if-exists=.env scripts/grant-admin.ts",
    "predeploy:check": "tsx --env-file-if-exists=.env scripts/predeploy-check.ts",
    "backfill:match-history": "tsx --env-file-if-exists=.env scripts/backfill-match-history.ts",
    "backfill:badges": "tsx --env-file-if-exists=.env scripts/backfill-badges.ts",
    "seed:venues": "tsx --env-file-if-exists=.env scripts/seed-venue-details.ts",
    "seed:home": "tsx --env-file-if-exists=.env scripts/seed-home-feed.ts",
    "cloudinary:setup": "tsx --env-file-if-exists=.env scripts/cloudinary-setup.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@as-integrations/express5": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@pothos/core": "^4.3.0",
    "@pothos/plugin-dataloader": "^4.4.0",
    "@pothos/plugin-relay": "^4.4.0",
    "@pothos/plugin-scope-auth": "^4.1.3",
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "express": "^5.0.1",
    "graphql": "^16.10.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "resend": "^4.1.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.17.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.6",
    "eslint": "^9.18.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
