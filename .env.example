# ─── Database ──────────────────────────────────────────────────────────────
# BOTH are required. Production is Neon; see docs/decisions/0001-neon-over-supabase.md §C2.
#   DATABASE_URL         pooled endpoint (PgBouncer, transaction mode) — the app
#   DIRECT_DATABASE_URL  direct endpoint — migrations and introspection ONLY
# Locally both point at the docker-compose Postgres.
DATABASE_URL="postgresql://pl4y:pl4y@localhost:5433/pl4y?schema=public"
DIRECT_DATABASE_URL="postgresql://pl4y:pl4y@localhost:5433/pl4y?schema=public"

# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="4000"
LOG_LEVEL="debug"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# ─── Auth ──────────────────────────────────────────────────────────────────
# RS256 PEM keypair. Generate a dev pair with:  npm run keys:dev
# Newlines must be literal \n when set as a single-line env var.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
ACCESS_TOKEN_TTL_SECONDS="900"        # 15 min  — identity R5
REFRESH_TOKEN_TTL_DAYS="60"           #          identity R6
OTP_TTL_MINUTES="10"                  #          identity R1
OTP_MAX_ATTEMPTS="5"                  #          identity R2
# Local development only — refused when NODE_ENV=production. Comma-separated
# addresses that `pnpm seed` creates and that sign in with DEV_OTP_CODE.
DEV_OTP_BYPASS_EMAILS=""
DEV_OTP_CODE="000000"
# Test / store-review accounts — work in production too. `pnpm seed` creates
# them; they sign in with TEST_LOGIN_CODE (6 digits, required, not 000000).
TEST_LOGIN_EMAILS=""
TEST_LOGIN_CODE=""

# ─── Email — Resend (ADR 0002) ─────────────────────────────────────────────
# Verify the sending domain and publish SPF/DKIM/DMARC before Sprint 1 ships.
RESEND_API_KEY=""
RESEND_FROM="PL4Y <support@getpl4y.com>"
RESEND_WEBHOOK_SECRET=""
# Buttons in emails link to paths under this (/app, /invite/:token, /app/registrations).
EMAIL_LINK_BASE="https://getpl4y.com"
# Where replies go; the refund email asks players to reply if money is late.
EMAIL_REPLY_TO=""
# Leave empty in dev to print codes to the log instead of sending mail.
EMAIL_TRANSPORT="console"             # console | resend

# ─── Registration ──────────────────────────────────────────────────────────
# Signs check-in QR codes. Required before any QR can be issued.
CHECKIN_TOKEN_SECRET=""

# ─── Push ──────────────────────────────────────────────────────────────────
PUSH_TRANSPORT="console"              # console | expo

# ─── Realtime — Pusher ─────────────────────────────────────────────────────
# Optional locally: empty means no publishes and /pusher/auth answers 503; the
# app falls back to polling.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"

# ─── Media — Cloudinary (ADR 0003) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
# ─── Payments ──────────────────────────────────────────────────────────────
# payments — none | razorpay. With razorpay, all four below are required.
PAYMENT_PROVIDER=none
# Dashboard → Account & Settings → API Keys. rzp_test_… in dev; production
# refuses to start without an rzp_live_… key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL ${PUBLIC_API_URL}/webhooks/payments, events
# payment.captured, payment.failed, refund.processed, refund.failed. The secret
# you type there goes here (it is not the key secret).
RAZORPAY_WEBHOOK_SECRET=
# Public origin of this API. The app opens checkout here and Razorpay posts the
# player back here, so a phone must reach it. In dev, an ngrok URL.
PUBLIC_API_URL=

# ─── Host payouts (spec 2026-10-02-host-payouts) ───────────────────────────
# none | mock | razorpayx | manual. `none` keeps paid publishing staff-only; `mock` is dev-only.
# `manual` — no RazorpayX: staff approve bank accounts in the admin portal, pay hosts
# from PL4Y's bank, then record each UTR there (Payouts → Ready to pay). Needs only
# PAYOUT_DATA_KEY (and PAYOUT_ALERT_EMAIL for the "ready to pay" email).
# PAYOUT_PROVIDER=mock
# RazorpayX API keys (x.razorpay.com → Developer Controls). Often the same pair
# as RAZORPAY_KEY_*; production refuses a test key.
# RAZORPAYX_KEY_ID=
# RAZORPAYX_KEY_SECRET=
# The RazorpayX account payouts are debited from, as the X dashboard shows it.
# RAZORPAYX_ACCOUNT_NUMBER=
# X dashboard → Webhooks: URL ${PUBLIC_API_URL}/webhooks/payouts, events
# payout.processed, payout.reversed, payout.failed, payout.rejected.
# RAZORPAYX_WEBHOOK_SECRET=
# 32 random bytes, base64; encrypts PAN and account number. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PAYOUT_DATA_KEY=
# Razorpay's name_match_score (0–100) at or above which a host verifies automatically.
# PAYOUT_NAME_MATCH_AUTO=80
# GST on the commission and TDS on payouts, in basis points. PL4Y is
# unregistered for GST, so both default to 0: a host receives the entry fees
# less the 10% commission. Set them only if that changes.
# COMMISSION_GST_BPS=0
# HOST_TDS_BPS=0
# Above this many paise a payout goes by NEFT instead of IMPS (₹5,00,000).
# PAYOUT_IMPS_MAX_PAISE=50000000
# Finance inbox for "top up the payouts account" and failed-payout alerts.
# PAYOUT_ALERT_EMAIL=

# ─── Pricing (gap #7) ──────────────────────────────────────────────────────
# PL4Y's platform fee on each paid entry, and the tax rate on what the player
# pays. Set by PL4Y, never by a host. PL4Y is unregistered for GST, so both are
# 0: the player pays exactly the entry fee and PL4Y keeps the 10% commission.
# PLATFORM_FEE_PAISE=0
# ENTRY_TAX_BPS=0
